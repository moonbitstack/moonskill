name = "moonbitstack/moonskill"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonskill"

license = "Apache-2.0"

keywords = [
  "agent-skills",
  "skills",
  "skill-md",
  "agentskills",
  "agent-skills-specification",
  "skills-ref",
  "frontmatter",
  "yaml",
  "markdown",
  "progressive-disclosure",
  "validation",
  "discovery",
  "parser",
  "prompt",
  "cli",
  "agent",
  "moonbit",
]

description = "Agent Skills for MoonBit: discover skill directories, read SKILL.md, validate it against the specification."

source = "src"

import {
  "moonbitstack/moonyaml@0.2.0",
  "moonbitstack/moonucd@0.2.0",
  "moonbitlang/async@0.22.5",
}
